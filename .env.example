# Copy to .env and fill in local values. Never commit real credentials.
OPENAI_API_KEY=
BRIGHT_DATA_API_KEY=
DAYTONA_API_KEY=

# TrueForge defaults to its local server without authentication.
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_AGENT_NAME=bizforge-research
# TRUEFORGE_TOKEN=

# Local mock MCP server. It always binds to loopback; only the port is configurable.
BIZFORGE_MCP_PORT=8791
