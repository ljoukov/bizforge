{
  "name": "bizforge",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-backed business opportunity research powered by TrueForge.",
  "type": "module",
  "engines": {
    "node": ">=24.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run secrets:check && npm run typecheck && npm run test:coverage && npm run build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "mcp:serve": "npm run build && npm run mcp:start",
    "mcp:start": "node --env-file-if-exists=.env dist/mcp/http-entrypoint.js",
    "secrets:check": "node scripts/check-secrets.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@truefoundry/trueforge-sdk": "0.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
